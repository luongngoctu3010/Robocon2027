<?xml version="1.0"?>
<sdf version="1.10">

  <world name="robocon2027">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 0 1.57079632679 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- ========================= -->
    <!-- ROBOTCON 2027 FIELD       -->
    <!-- ========================= -->

    <include>
      <uri>model://robocon2027_field</uri>
      <name>robocon2027_field</name>
      <pose>0 0 0 1.57079632679 0 0</pose>
    </include>

    <!-- ========================= -->
    <!-- PHYSICS GROUND             -->
    <!-- ========================= -->

    <model name="ground_collision">
      <static>true</static>

      <link name="ground">

        <collision name="ground_collision">
          <pose>0 0 -0.05 0 0 0</pose>

          <geometry>
            <box>
              <size>11.05 11.05 0.10</size>
            </box>
          </geometry>

        </collision>

      </link>
    </model>

    <!-- ========================= -->
    <!-- BR ROBOT                   -->
    <!-- ========================= -->

    <include>
      <uri>model://br_robot</uri>
      <name>BR</name>

      <!-- X=-4, Y=-4, Z=0.5 -->
      <pose>-4 -4 0.5 0 0 0</pose>

    </include>

  </world>

</sdf>
