<?xml version="1.0"?>

<sdf version="1.10">

  <model name="robocon2027_field">

    <static>true</static>

    <!-- VISUAL: GLB giữ màu từ Blender -->
    <link name="field">

      <visual name="field_visual">

        <geometry>
          <mesh>
            <uri>model://robocon2027_field/meshes/Robocon2027.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>

      <!-- COLLISION: STL -->
      <collision name="field_collision">

        <geometry>
          <mesh>
            <uri>model://robocon2027_field/meshes/Robocon2027.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>
