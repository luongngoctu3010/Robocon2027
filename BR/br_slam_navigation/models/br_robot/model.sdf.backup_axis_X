<?xml version="1.0"?>
<sdf version="1.10">
  <model name="br_robot">

    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- ================= BASE ================= -->
    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>

      <inertial>
        <mass>40.0</mass>
        <inertia>
          <ixx>1.60</ixx>
          <iyy>2.53</iyy>
          <izz>3.07</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.80 0.60 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.80 0.60 0.20</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- ================= 4 BÁNH LỚN Ø160 ================= -->

    <link name="left_front_wheel">
      <pose>0.28 0.33 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.00256</ixx><iyy>0.00256</iyy><izz>0.00512</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="right_front_wheel">
      <pose>0.28 -0.33 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.00256</ixx><iyy>0.00256</iyy><izz>0.00512</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="left_rear_wheel">
      <pose>-0.28 0.33 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.00256</ixx><iyy>0.00256</iyy><izz>0.00512</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <link name="right_rear_wheel">
      <pose>-0.28 -0.33 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.00256</ixx><iyy>0.00256</iyy><izz>0.00512</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.08</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
    </link>

    <!-- ================= 2 BÁNH NHỎ Ø50 ================= -->

    <link name="left_middle_wheel">
      <pose>0 0.33 0.025 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000047</ixx><iyy>0.000047</iyy><izz>0.000094</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.025</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
    </link>

    <link name="right_middle_wheel">
      <pose>0 -0.33 0.025 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000047</ixx><iyy>0.000047</iyy><izz>0.000094</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.025</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>
    </link>

    <!-- ================= 6 JOINT ================= -->

    <joint name="left_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="left_rear_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_rear_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="left_middle_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_middle_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_middle_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_middle_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- ================= LIDAR ================= -->

    <link name="lidar_link">
      <pose>0 0 0.32 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.04</length></cylinder>
        </geometry>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ================= GAZEBO ================= -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_front_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>

      <right_joint>right_front_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>

      <wheel_separation>0.66</wheel_separation>
      <wheel_radius>0.08</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

  
    <!-- DIRECT LOCAL-Z WHEEL VELOCITY CONTROLLERS -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>left_front_joint</joint_name>
      <topic>/model/BR/joint/left_front_joint/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>right_front_joint</joint_name>
      <topic>/model/BR/joint/right_front_joint/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>left_rear_joint</joint_name>
      <topic>/model/BR/joint/left_rear_joint/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>right_rear_joint</joint_name>
      <topic>/model/BR/joint/right_rear_joint/cmd_vel</topic>
    </plugin>

  </model>
</sdf>
