<?xml version="1.0"?>

<sdf version="1.10">

  <model name="br_robot">

    <pose>0 0 0.18 0 0 0</pose>

    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- ================================================= -->
    <!-- BASE -->
    <!-- ================================================= -->

    <link name="base_link">

      <inertial>
        <mass>40.0</mass>

        <inertia>
          <ixx>3.0</ixx>
          <iyy>4.0</iyy>
          <izz>5.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">

        <geometry>
          <box>
            <size>0.80 0.60 0.20</size>
          </box>
        </geometry>

        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>

      </visual>

      <collision name="base_collision">

        <geometry>
          <box>
            <size>0.80 0.60 0.20</size>
          </box>
        </geometry>

      </collision>

    </link>


    <!-- ================================================= -->
    <!-- LEFT FRONT WHEEL -->
    <!-- ================================================= -->

    <link name="left_front_wheel">

      <pose>0.28 0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

      </collision>

    </link>


    <!-- LEFT MIDDLE WHEEL -->

    <link name="left_middle_wheel">

      <pose>0 0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- LEFT REAR WHEEL -->

    <link name="left_rear_wheel">

      <pose>-0.28 0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- RIGHT FRONT WHEEL -->

    <link name="right_front_wheel">

      <pose>0.28 -0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- RIGHT MIDDLE WHEEL -->

    <link name="right_middle_wheel">

      <pose>0 -0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- RIGHT REAR WHEEL -->

    <link name="right_rear_wheel">

      <pose>-0.28 -0.33 -0.10 1.57079632679 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- ================================================= -->
    <!-- WHEEL JOINTS -->
    <!-- ================================================= -->

    <joint name="left_front_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>left_front_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <joint name="left_middle_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>left_middle_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <joint name="left_rear_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>left_rear_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <joint name="right_front_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>right_front_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <joint name="right_middle_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>right_middle_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <joint name="right_rear_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>right_rear_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <!-- ================================================= -->
    <!-- LIDAR -->
    <!-- ================================================= -->

    <link name="lidar_link">

      <pose>0 0 0.28 0 0 0</pose>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <sensor name="lidar" type="gpu_lidar">

        <pose>0 0 0 0 0 0</pose>

        <update_rate>10</update_rate>

        <topic>/scan</topic>

        <ray>

          <scan>

            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>

          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>

        </ray>

        <always_on>true</always_on>
        <visualize>true</visualize>

      </sensor>

    </link>


    <joint name="lidar_joint"
           type="fixed">

      <parent>base_link</parent>
      <child>lidar_link</child>

    </joint>


    <!-- ================================================= -->
    <!-- GAZEBO SYSTEMS -->
    <!-- ================================================= -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_front_joint</left_joint>
      <left_joint>left_middle_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>

      <right_joint>right_front_joint</right_joint>
      <right_joint>right_middle_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>

      <wheel_separation>0.66</wheel_separation>
      <wheel_radius>0.06</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

    </plugin>


    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher"/>


    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>


  </model>

</sdf>
