/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdint.h>
#include <string.h>

/* Private variables ---------------------------------------------------------*/

UART_HandleTypeDef huart3;

/* Private function prototypes -----------------------------------------------*/

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

/* Main Program --------------------------------------------------------------*/

int main(void)
{
    /* 1. Khoi tao HAL */
    HAL_Init();

    /* 2. Cau hinh System Clock */
    SystemClock_Config();

    /* 3. Khoi tao GPIO */
    MX_GPIO_Init();

    /* 4. Khoi tao USART3 */
    MX_USART3_UART_Init();

    /* 5. Bien nhan du lieu */
    uint8_t rx_data;

    /* 6. Gui thong bao khi STM32 khoi dong */
    const char *welcome =
        "\r\nSTM32F767 READY - ECHO TEST\r\n";

    if (HAL_UART_Transmit(&huart3,
                          (uint8_t *)welcome,
                          strlen(welcome),
                          1000) != HAL_OK)
    {
        Error_Handler();
    }

    /* 7. Vong lap Echo */
    while (1)
    {
        /*
         * Cho nhan 1 byte tu Ubuntu
         */
        if (HAL_UART_Receive(&huart3,
                             &rx_data,
                             1,
                             HAL_MAX_DELAY) == HAL_OK)
        {
            /*
             * Gui tra lai dung byte vua nhan
             */
            if (HAL_UART_Transmit(&huart3,
                                  &rx_data,
                                  1,
                                  1000) != HAL_OK)
            {
                Error_Handler();
            }
        }
    }
}

