 * ============================================================================
 * @file           : main.c
 * @brief          : Test UART1 TX transmitting continuous string on STM32F767ZIT6
 * ============================================================================
 */
/* USER CODE END Header */

#include "main.h"
#include <string.h>

UART_HandleTypeDef huart1;

static void MPU_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
void SystemClock_Config(void);
void Error_Handler(void);

int main(void)
{
    /* MPU Configuration--------------------------------------------------*/
    MPU_Config();

    /* MCU Configuration--------------------------------------------------*/
    HAL_Init();

    /* Configure the system clock */
    SystemClock_Config();

    /* Initialize all configured peripherals */
    MX_GPIO_Init();
    MX_USART1_UART_Init();

    /* Chuỗi ký tự cần truyền xuống PA9 */
    char *test_msg = "qqqqqqqqqqwwwwwwwwiiiiiiiiiiiiiiiii\r\n";
    uint16_t msg_len = strlen(test_msg);

    while (1)
    {
        /* Truyền chuỗi qua UART1 (Chân PA9 là TX) với timeout 100ms */
        HAL_UART_Transmit(&huart1, (uint8_t*)test_msg, msg_len, 100);

        /* Delay 500ms giữa các lần gửi để dễ quan sát */
        HAL_Delay(500);
    }
}

