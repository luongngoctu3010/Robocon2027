/* USER CODE BEGIN Header */
/**
 * ============================================================================
 * @file           : main.c
 * @brief          : Ethernet UDP to Hoverboard UART Bridge for STM32F767ZIT6
 * ============================================================================
 * System Architecture:
 *   Ubuntu MiniPC ---> [ Ethernet UDP (192.168.1.100:5000) ] ---> STM32F767ZIT6
 *                                                                    |
 *                                                                    | USART1 (PA9/PA10)
 *                                                                    v
 *                                                             Hoverboard FRONT (STM32F103)
 *
 * UDP Payload Format (8 bytes):
 *   - Byte 0-1: FL int16_t (mm/s)
 *   - Byte 2-3: FR int16_t (mm/s)
 *   - Byte 4-5: RL int16_t (mm/s - ignored)
 *   - Byte 6-7: RR int16_t (mm/s - ignored)
 *
 * Hoverboard UART Protocol:
 *   - Baudrate : 115200
 *   - Start    : 0xABCD
 *   - Checksum : XOR
 *   - Packet   : 8 bytes
 * ============================================================================
 */
/* USER CODE END Header */

/* Includes ----------------------------------------------------------*/
#include "main.h"
#include "lwip.h"
#include "lwip/udp.h"
#include "lwip/pbuf.h"
#include "lwip/ip_addr.h"

#include <stdint.h>
#include <string.h>

/* Private defines ---------------------------------------------------*/
#define UDP_SERVER_PORT          5000
#define UDP_PACKET_SIZE          8
#define UDP_TIMEOUT_MS           200

#define HOVERBOARD_START_FRAME   0xABCD
#define MAX_WHEEL_SPEED_MM_S     1300
#define WHEEL_DIAMETER_MM        160.0f
#define HOVERBOARD_MAX_RPM       1000.0f
#define CONTROL_PERIOD_MS        20

/* UART handle -------------------------------------------------------*/
UART_HandleTypeDef huart1;

/* Private variables -------------------------------------------------*/
static struct udp_pcb *udp_server_pcb = NULL;

static volatile int16_t wheel_FL = 0;
static volatile int16_t wheel_FR = 0;

static volatile uint32_t last_udp_tick = 0;
static volatile uint8_t command_received = 0;

/* Function prototypes -----------------------------------------------*/
static void MPU_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
void SystemClock_Config(void);
void Error_Handler(void);

static int16_t read_int16_le(const uint8_t *data);
static int16_t convert_speed_to_command(int16_t speed);
static void send_hoverboard_command(UART_HandleTypeDef *huart, int16_t left, int16_t right);
static void send_stop_command(void);
static void udp_server_init(void);
static void udp_server_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port);

/* Read signed int16 little endian -----------------------------------*/
static int16_t read_int16_le(const uint8_t *data)
{
    uint16_t value;
    value = (uint16_t)data[0];
    value |= ((uint16_t)data[1] << 8);
    return (int16_t)value;
}

/* Convert wheel speed mm/s to Hoverboard command --------------------*/
static int16_t convert_speed_to_command(int16_t speed)
{
    float rpm;
    float command;

    /* Wheel diameter = 160 mm. RPM = v * 60 / (pi * D) */
    rpm = ((float)speed * 60.0f) / (3.14159265f * WHEEL_DIAMETER_MM);

    /* Convert RPM to normalized command (HOVERBOARD_MAX_RPM = 1000) */
    command = rpm * 1000.0f / HOVERBOARD_MAX_RPM;

    if (command > 1000.0f)  command = 1000.0f;
    if (command < -1000.0f) command = -1000.0f;

    return (int16_t)command;
}

/* Send one Hoverboard command ---------------------------------------*/
static void send_hoverboard_command(UART_HandleTypeDef *huart, int16_t left, int16_t right)
{
    uint8_t packet[8];
    int32_t speed;
    int32_t steer;
    uint16_t checksum;

    /*
     * Mixer convention:
     *   Left  = speed + steer
     *   Right = speed - steer
     * Inverse:
     *   speed = (left + right) / 2
     *   steer = (left - right) / 2
     */
    speed = ((int32_t)left + (int32_t)right) / 2;
    steer = ((int32_t)left - (int32_t)right) / 2;

    /* Limit speed & steer */
    if (speed > 1000)   speed = 1000;
    if (speed < -1000)  speed = -1000;
    if (steer > 1000)   steer = 1000;
    if (steer < -1000)  steer = -1000;

    /* Calculate XOR checksum */
    checksum = (uint16_t)HOVERBOARD_START_FRAME
             ^ (uint16_t)(int16_t)steer
             ^ (uint16_t)(int16_t)speed;

    /* Packet format (Little Endian):
     * Byte 0-1: Start frame (0xABCD -> 0xCD, 0xAB)
     * Byte 2-3: Steer
     * Byte 4-5: Speed
     * Byte 6-7: Checksum
     */
    packet[0] = 0xCD;
    packet[1] = 0xAB;

    packet[2] = (uint8_t)((uint16_t)(int16_t)steer);
    packet[3] = (uint8_t)(((uint16_t)(int16_t)steer) >> 8);

    packet[4] = (uint8_t)((uint16_t)(int16_t)speed);
    packet[5] = (uint8_t)(((uint16_t)(int16_t)speed) >> 8);

    packet[6] = (uint8_t)checksum;
    packet[7] = (uint8_t)(checksum >> 8);

    /* Transmit UART */
    if (huart != NULL)
    {
        HAL_UART_Transmit(huart, packet, sizeof(packet), 10);
    }
}

/* Stop FRONT Hoverboard ---------------------------------------------*/
static void send_stop_command(void)
{
    send_hoverboard_command(&huart1, 0, 0);
}

/* UDP receive callback ----------------------------------------------*/
static void udp_server_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
    uint8_t data[UDP_PACKET_SIZE];
    int16_t FL;
    int16_t FR;
    u16_t copied;

    (void)arg;
    (void)upcb;
    (void)addr;
    (void)port;

    if (p == NULL) return;

    /* Require exactly 8 bytes */
    if (p->tot_len != UDP_PACKET_SIZE)
    {
        pbuf_free(p);
        return;
    }

    copied = pbuf_copy_partial(p, data, UDP_PACKET_SIZE, 0);
    pbuf_free(p);

    if (copied != UDP_PACKET_SIZE) return;

    /* Decode front wheel speeds (FL, FR) */
    FL = read_int16_le(&data[0]);
    FR = read_int16_le(&data[2]);

    /* Check requested speed bounds */
    if (FL > MAX_WHEEL_SPEED_MM_S || FL < -MAX_WHEEL_SPEED_MM_S ||
        FR > MAX_WHEEL_SPEED_MM_S || FR < -MAX_WHEEL_SPEED_MM_S)
    {
        return;
    }

    /* Update wheel commands */
    wheel_FL = convert_speed_to_command(FL);
    wheel_FR = convert_speed_to_command(FR);

    /* Update watchdog */
    last_udp_tick = HAL_GetTick();
    command_received = 1;
}

/* UDP server initialization ----------------------------------------*/
static void udp_server_init(void)
{
    err_t err;

    udp_server_pcb = udp_new();
    if (udp_server_pcb == NULL)
    {
        Error_Handler();
    }

    err = udp_bind(udp_server_pcb, IP_ADDR_ANY, UDP_SERVER_PORT);
    if (err != ERR_OK)
    {
        udp_remove(udp_server_pcb);
        udp_server_pcb = NULL;
        Error_Handler();
    }

    udp_recv(udp_server_pcb, udp_server_callback, NULL);
}

/* Main --------------------------------------------------------------*/
int main(void)
{
    uint32_t last_control_tick = 0;
    uint32_t now;
    uint32_t last_packet;
    uint8_t received;
    int16_t FL;
    int16_t FR;

    MPU_Config();
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();
    MX_LWIP_Init();

    udp_server_init();

    send_stop_command();
    last_udp_tick = HAL_GetTick();

    while (1)
    {
        /* LwIP NO_SYS = 1: Process network packets continuously */
        MX_LWIP_Process();

        now = HAL_GetTick();

        /* Control period = 20 ms */
        if ((now - last_control_tick) >= CONTROL_PERIOD_MS)
        {
            last_control_tick = now;

            /* Read shared variables safely */
            __disable_irq();
            FL = wheel_FL;
            FR = wheel_FR;
            last_packet = last_udp_tick;
            received = command_received;
            __enable_irq();

            /* UDP watchdog (200 ms timeout): stop motors if no packet arrives */
            if (received && ((now - last_packet) > UDP_TIMEOUT_MS))
            {
                FL = 0;
                FR = 0;

                __disable_irq();
                wheel_FL = 0;
                wheel_FR = 0;
                command_received = 0;
                __enable_irq();
            }

            /* Send command to FRONT Hoverboard via USART1 (PA9=TX, PA10=RX) */
            send_hoverboard_command(&huart1, FL, FR);
        }
    }
}

/* System Clock Configuration ---------------------------------------*/
void SystemClock_Config(void)
{
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

    /* HSI = 16 MHz, PLL -> SYSCLK = 216 MHz */
    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
    RCC_OscInitStruct.HSIState = RCC_HSI_ON;
    RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
    RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSI;
    RCC_OscInitStruct.PLL.PLLM = 8;
    RCC_OscInitStruct.PLL.PLLN = 216;
    RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
    RCC_OscInitStruct.PLL.PLLQ = 9;

    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
    {
        Error_Handler();
    }

    if (HAL_PWREx_EnableOverDrive() != HAL_OK)
    {
        Error_Handler();
    }

    RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK |
                                  RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
    RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;

    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_7) != HAL_OK)
    {
        Error_Handler();
    }
}

