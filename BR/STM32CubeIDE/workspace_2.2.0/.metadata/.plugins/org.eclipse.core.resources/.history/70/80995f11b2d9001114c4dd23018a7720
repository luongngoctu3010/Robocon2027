#define UDP_PORT                5005
#define HOVERBOARD_BAUDRATE     115200

#define UART_TIMEOUT            100

/* =========================================================
 * GLOBAL VARIABLES
 * ========================================================= */

UART_HandleTypeDef huart1;

static struct udp_pcb *udp_pcb_bridge = NULL;

volatile uint32_t udp_rx_packets = 0;
volatile uint32_t udp_rx_bytes = 0;

volatile uint32_t uart_tx_bytes = 0;
volatile uint32_t uart_tx_errors = 0;

volatile uint32_t udp_rx_errors = 0;

/* =========================================================
 * FUNCTION PROTOTYPES
 * ========================================================= */

void SystemClock_Config(void);
void MPU_Config(void);
void Error_Handler(void);

static void USART1_Init(void);
static void UDP_Bridge_Init(void);

static void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
);

/* =========================================================
 * USART1 INITIALIZATION
 *
 * STM32F767ZI:
 * PA9  = USART1_TX
 * PA10 = USART1_RX
 *
 * Baudrate = 115200
 * Data     = 8 bits
 * Stop     = 1 bit
 * Parity   = None
 * ========================================================= */

static void USART1_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_USART1_CLK_ENABLE();

    GPIO_InitStruct.Pin = GPIO_PIN_9 | GPIO_PIN_10;
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
    GPIO_InitStruct.Alternate = GPIO_AF7_USART1;

    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

    huart1.Instance = USART1;

    huart1.Init.BaudRate = HOVERBOARD_BAUDRATE;
    huart1.Init.WordLength = UART_WORDLENGTH_8B;
    huart1.Init.StopBits = UART_STOPBITS_1;
    huart1.Init.Parity = UART_PARITY_NONE;
    huart1.Init.Mode = UART_MODE_TX_RX;
    huart1.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart1.Init.OverSampling = UART_OVERSAMPLING_16;

    if (HAL_UART_Init(&huart1) != HAL_OK)
    {
        Error_Handler();
    }
}

/* =========================================================
 * UDP RECEIVE CALLBACK
 *
 * Receive UDP packet from Mini PC.
 *
 * Forward all received bytes directly to USART1.
 *
 * IMPORTANT:
 * - Do not modify packet data.
 * - Do not add header.
 * - Do not recalculate checksum.
 * - Do not change byte order.
 * ========================================================= */

static void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
)
{
    struct pbuf *q;

    (void)arg;
    (void)pcb;
    (void)addr;
    (void)port;

    if (p == NULL)
    {
        return;
    }

    udp_rx_packets++;
    udp_rx_bytes += p->tot_len;

    /*
     * A UDP payload may consist of multiple pbuf blocks.
     * Forward every block in order.
     */

    for (q = p; q != NULL; q = q->next)
    {
        if (q->len == 0)
        {
            continue;
        }

        if (HAL_UART_Transmit(
                &huart1,
                (uint8_t *)q->payload,
                q->len,
                UART_TIMEOUT
            ) == HAL_OK)
        {
            uart_tx_bytes += q->len;
        }
        else
        {
            uart_tx_errors++;
        }
    }

    /* Release received UDP buffer */

    pbuf_free(p);
}

/* =========================================================
 * UDP BRIDGE INITIALIZATION
 *
 * Listen on UDP port 5005.
 * ========================================================= */

static void UDP_Bridge_Init(void)
{
    err_t err;

    udp_pcb_bridge = udp_new();

    if (udp_pcb_bridge == NULL)
    {
        Error_Handler();
    }

    err = udp_bind(
        udp_pcb_bridge,
        IP_ADDR_ANY,
        UDP_PORT
    );

    if (err != ERR_OK)
    {
        udp_remove(udp_pcb_bridge);
        udp_pcb_bridge = NULL;

        Error_Handler();
    }

    udp_recv(
        udp_pcb_bridge,
        UDP_Receive_Callback,
        NULL
    );
}

/* =========================================================
 * MAIN
 * ========================================================= */

int main(void)
{
    /* Configure MPU */

    MPU_Config();

    /* Initialize HAL */

    HAL_Init();

    /* Configure system clock */

    SystemClock_Config();

    /* Initialize GPIO */

    MX_GPIO_Init();

    /* Initialize USART1 */

    USART1_Init();

    /* Initialize LwIP */

    MX_LWIP_Init();

    /* Initialize UDP bridge */

    UDP_Bridge_Init();

    /* Main loop */

    while (1)
    {
        MX_LWIP_Process();
    }
}

