/*=========================================
 * ERROR HANDLER
 *=========================================*/

void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
    }
}

/*=========================================
 * MAIN
 *=========================================*/

int main(void)
{
    uint8_t test_data = 0x55;

    HAL_StatusTypeDef uart_status;

    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    MX_USART1_UART_Init();

    /*
     * TEST USART1 TX
     *
     * PA9 continuously sends 0x55.
     * Baudrate: 115200
     * Format: 8N1
     * Interval: 500 ms
     *
     * Temporarily disable Ethernet/LwIP
     * to isolate UART hardware testing.
     */

    while (1)
    {
        uart_status = HAL_UART_Transmit(
            &huart1,
            &test_data,
            1,
            100
        );

        HAL_Delay(500);

        /*
         * Inspect uart_status in debugger:
         *
         * HAL_OK    = transmission accepted
         * HAL_ERROR = transmission error
         * HAL_BUSY  = UART busy
         * HAL_TIMEOUT = transmission timeout
         */

        (void)uart_status;
    }
}
