
#include "main.h"

/*=========================================
 * GPIO PA9 TEST
 *
 * PA9 = GPIO OUTPUT
 * HIGH: 3.3V
 * LOW : 0V
 *=========================================*/

int main(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    HAL_Init();

    /* Enable GPIOA clock */
    __HAL_RCC_GPIOA_CLK_ENABLE();

    /* Configure PA9 as GPIO output */
    GPIO_InitStruct.Pin = GPIO_PIN_9;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_VERY_HIGH;

    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

    /* Continuously toggle PA9 */
    while (1)
    {
        HAL_GPIO_WritePin(
            GPIOA,
            GPIO_PIN_9,
            GPIO_PIN_SET
        );

        HAL_Delay(500);

        HAL_GPIO_WritePin(
            GPIOA,
            GPIO_PIN_9,
            GPIO_PIN_RESET
        );

        HAL_Delay(500);
    }
}
