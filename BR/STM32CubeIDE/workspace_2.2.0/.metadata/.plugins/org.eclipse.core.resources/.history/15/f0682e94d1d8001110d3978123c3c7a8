  * @file           : main.c
  * @brief          : Simple LED Blinking for STM32F767
  ******************************************************************************
  */
/* USER CODE END Header */

#include "main.h"

void SystemClock_Config(void);
static void MX_GPIO_Init(void);

int main(void)
{
  /* 1. Khởi tạo thư viện HAL, cấu hình Flash và Tick timer */
  HAL_Init();

  /* 2. Cấu hình xung nhịp hệ thống */
  SystemClock_Config();

  /* 3. Khởi tạo chân GPIO cho LED */
  MX_GPIO_Init();

  /* Vòng lặp chính nhấp nháy LED */
  while (1)
  {
    /* Bật LED (Kéo mức cao / High) - Thay đổi chân tùy thuộc theo sơ đồ mạch của bạn */
    HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);

    /* Chờ 500 mili-giây */
    HAL_Delay(500);
  }
}

