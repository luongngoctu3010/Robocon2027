/**
 * ============================================================================
 * @file           : main.c
 * @brief          : Transparent UDP to UART Bridge for STM32F767ZIT6
 * ============================================================================
 * Ubuntu MiniPC ---> [ UDP Port 5000 ] ---> STM32F767 ---> UART1 (PA9/PA10) ---> Hoverboard
 * ============================================================================
 */
/* USER CODE END Header */

#include "main.h"
#include "lwip.h"
#include "lwip/udp.h"
#include "lwip/pbuf.h"
#include "lwip/ip_addr.h"
#include <string.h>

#define UDP_SERVER_PORT 5000

UART_HandleTypeDef huart1;
static struct udp_pcb *udp_server_pcb = NULL;

static void MPU_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
void SystemClock_Config(void);
void Error_Handler(void);

// Hàm nhận UDP callback: Nhận được gì truyền thẳng qua UART nấy
static void udp_server_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
    (void)arg;
    (void)upcb;
    (void)addr;
    (void)port;

    if (p == NULL) return;

    // Cấp phát bộ đệm tạm để chứa dữ liệu UDP nhận được
    uint16_t data_len = p->tot_len;
    if (data_len > 0 && data_len <= 64)
    {
        uint8_t tx_buf[64];
        pbuf_copy_partial(p, tx_buf, data_len, 0);

        // Truyền thẳng ra UART1 (PA9/PA10) xuống Hoverboard không sửa đổi
        HAL_UART_Transmit(&huart1, tx_buf, data_len, 10);
    }

    pbuf_free(p);
}

static void udp_server_init(void)
{
    udp_server_pcb = udp_new();
    if (udp_server_pcb == NULL) Error_Handler();

    if (udp_bind(udp_server_pcb, IP_ADDR_ANY, UDP_SERVER_PORT) != ERR_OK)
    {
        udp_remove(udp_server_pcb);
        Error_Handler();
    }

    udp_recv(udp_server_pcb, udp_server_callback, NULL);
}

int main(void)
{
    MPU_Config();
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();
    MX_LWIP_Init();

    udp_server_init();

    while (1)
    {
        MX_LWIP_Process(); // Duy trì gói tin mạng LwIP
    }
}

