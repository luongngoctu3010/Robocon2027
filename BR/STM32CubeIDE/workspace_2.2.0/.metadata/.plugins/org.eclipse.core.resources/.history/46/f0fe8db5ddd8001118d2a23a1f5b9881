#include "main.h"
#include <string.h>

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1; // Kết nối Hoverboard (PA9/PA10 - 9600 baud)
UART_HandleTypeDef huart3; // Kết nối Ubuntu PC qua ST-LINK VCP (115200 baud)

uint8_t pc_rx_buffer[8];   // Bộ đệm nhận gói tin 8 byte từ Ubuntu PC

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

/* Main Application ----------------------------------------------------------*/
int main(void)
{
    /* 1. Khởi tạo thư viện HAL, cấu hình Flash và Tick timer */
    HAL_Init();

    /* 2. Cấu hình xung nhịp hệ thống */
    SystemClock_Config();

    /* 3. Khởi tạo chân GPIO cho các cổng UART */
    MX_GPIO_Init();

    /* 4. Khởi tạo các ngoại vi UART */
    MX_USART1_UART_Init(); // USART1: Hoverboard (9600 baud)
    MX_USART3_UART_Init(); // USART3: Ubuntu PC (115200 baud)

    /* 5. Gửi thông báo khởi động qua VCP để kiểm tra kết nối với Ubuntu */
    char *welcome = "\r\n[INFO] STM32F767 Bridge to Hoverboard Initialized\r\n";
    HAL_UART_Transmit(&huart3, (uint8_t*)welcome, strlen(welcome), 100);

    /* 6. Bắt đầu kích hoạt ngắt nhận gói 8 byte đầu tiên từ Ubuntu PC qua USART3 */
    if (HAL_UART_Receive_IT(&huart3, pc_rx_buffer, 8) != HAL_OK)
    {
        Error_Handler();
    }

    /* Vòng lặp vô hạn chờ xử lý ngắt */
    while (1)
    {
    }
}

/* UART Receive Complete Callback (Xử lý ngắt nhận dữ liệu từ Ubuntu) --------*/
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART3)
    {
        /* Chuyển tiếp nguyên vẹn 8 byte dữ liệu xuống Hoverboard qua USART1 (PA9/PA10) */
        HAL_UART_Transmit(&huart1, pc_rx_buffer, 8, 100);

        /* Tiếp tục lắng nghe gói 8 byte tiếp theo từ Ubuntu PC */
        if (HAL_UART_Receive_IT(&huart3, pc_rx_buffer, 8) != HAL_OK)
        {
            Error_Handler();
        }
    }
}

