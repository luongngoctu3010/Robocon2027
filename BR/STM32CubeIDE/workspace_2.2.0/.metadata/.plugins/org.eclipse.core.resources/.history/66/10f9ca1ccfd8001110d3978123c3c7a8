/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <string.h>

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1;
UART_HandleTypeDef huart3;

uint8_t pc_rx_buffer[8];

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

/* Main Program --------------------------------------------------------------*/
int main(void)
{
    /* 1. Reset tất cả ngoại vi, khởi tạo Flash interface và Tick timer */
    HAL_Init();

    /* 2. Cấu hình xung nhịp hệ thống (System Clock) */
    SystemClock_Config();

    /* 3. Khởi tạo cấu hình chân GPIO (Alternate Function cho USART) */
    MX_GPIO_Init();

    /* 4. Khởi tạo các cổng UART */
    MX_USART1_UART_Init(); // Kết nối Hoverboard (9600 baud)
    MX_USART3_UART_Init(); // Kết nối Ubuntu PC qua ST-Link VCP (115200 baud)

    /* 5. Gửi chuỗi thông báo khởi động nhẹ nhàng qua VCP */
    const char *welcome = "\r\n[INFO] STM32F767 UART Bridge Ready\r\n";
    HAL_UART_Transmit(&huart3, (uint8_t *)welcome, strlen(welcome), 100);

    /* 6. Kích hoạt ngắt nhận 8 bytes đầu tiên từ Ubuntu PC */
    if (HAL_UART_Receive_IT(&huart3, pc_rx_buffer, 8) != HAL_OK)
    {
        Error_Handler();
    }

    /* Infinite loop */
    while (1)
    {
        // Hệ thống vận hành hoàn toàn tự động bằng ngắt UART
    }
}

/* UART Receive Complete Callback -------------------------------------------*/
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART3)
    {
        // Chuyển tiếp nguyên vẹn 8 bytes dữ liệu xuống Hoverboard qua USART1
        HAL_UART_Transmit(&huart1, pc_rx_buffer, 8, 100);

        // Tiếp tục lắng nghe gói 8 bytes tiếp theo từ Ubuntu PC
        if (HAL_UART_Receive_IT(&huart3, pc_rx_buffer, 8) != HAL_OK)
        {
            Error_Handler();
        }
    }
}

