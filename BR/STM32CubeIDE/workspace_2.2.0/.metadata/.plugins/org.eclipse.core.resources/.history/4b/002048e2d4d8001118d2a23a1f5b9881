
#include "main.h"
#include <string.h>
#include <stdint.h>

/* UART handle */
UART_HandleTypeDef huart3;

/* Function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);


/* ======================== MAIN ======================== */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    MX_USART3_UART_Init();

    uint8_t rx_data;

    /* Cho Ubuntu biet STM32 da khoi dong */
    const char *msg = "\r\nSTM32F767 READY\r\n";

    HAL_UART_Transmit(
        &huart3,
        (uint8_t *)msg,
        strlen(msg),
        1000
    );

    while (1)
    {
        /*
         * Cho nhan 1 byte tu Ubuntu
         */
        if (HAL_UART_Receive(
                &huart3,
                &rx_data,
                1,
                HAL_MAX_DELAY
            ) == HAL_OK)
        {
            /*
             * Gui lai dung byte vua nhan
             */
            HAL_UART_Transmit(
                &huart3,
                &rx_data,
                1,
                1000
            );
        }
    }
}


