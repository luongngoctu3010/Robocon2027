/* =========================================================
   CONFIGURATION
   ========================================================= */

#define UDP_PORT               5005
#define HOVERBOARD_BAUDRATE    115200

/* =========================================================
   GLOBAL VARIABLES
   ========================================================= */

UART_HandleTypeDef huart1;

static struct udp_pcb *udp_pcb_bridge = NULL;

volatile uint32_t udp_rx_packets = 0;
volatile uint32_t uart_tx_bytes = 0;
volatile uint32_t uart_tx_errors = 0;

/* =========================================================
   FUNCTION PROTOTYPES
   ========================================================= */

void SystemClock_Config(void);
void MPU_Config(void);
void Error_Handler(void);

static void USART1_Init(void);
static void UDP_Bridge_Init(void);

static void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
);

/* =========================================================
   USART1 INITIALIZATION
   PA9  = TX
   PA10 = RX
   ========================================================= */

static void USART1_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_USART1_CLK_ENABLE();

    /* PA9 - USART1_TX */
    /* PA10 - USART1_RX */

    GPIO_InitStruct.Pin = GPIO_PIN_9 | GPIO_PIN_10;
    GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
    GPIO_InitStruct.Alternate = GPIO_AF7_USART1;

    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

    huart1.Instance = USART1;

    huart1.Init.BaudRate = HOVERBOARD_BAUDRATE;
    huart1.Init.WordLength = UART_WORDLENGTH_8B;
    huart1.Init.StopBits = UART_STOPBITS_1;
    huart1.Init.Parity = UART_PARITY_NONE;
    huart1.Init.Mode = UART_MODE_TX_RX;
    huart1.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart1.Init.OverSampling = UART_OVERSAMPLING_16;

    if (HAL_UART_Init(&huart1) != HAL_OK)
    {
        Error_Handler();
    }
}

/* =========================================================
   UDP RECEIVE CALLBACK
   Ethernet -> UART1 -> Hoverboard

   No modification of received bytes.
   ========================================================= */

static void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
)
{
    struct pbuf *q;

    if (p == NULL)
    {
        return;
    }

    udp_rx_packets++;

    for (q = p; q != NULL; q = q->next)
    {
        if (q->len > 0)
        {
            HAL_StatusTypeDef status;

            status = HAL_UART_Transmit(
                &huart1,
                (uint8_t *)q->payload,
                q->len,
                100
            );

            if (status == HAL_OK)
            {
                uart_tx_bytes += q->len;
            }
            else
            {
                uart_tx_errors++;
            }
        }
    }

    pbuf_free(p);
}

/* =========================================================
   UDP BRIDGE INITIALIZATION
   ========================================================= */

static void UDP_Bridge_Init(void)
{
    err_t err;

    udp_pcb_bridge = udp_new();

    if (udp_pcb_bridge == NULL)
    {
        Error_Handler();
    }

    err = udp_bind(
        udp_pcb_bridge,
        IP_ADDR_ANY,
        UDP_PORT
    );

    if (err != ERR_OK)
    {
        udp_remove(udp_pcb_bridge);
        udp_pcb_bridge = NULL;

        Error_Handler();
    }

    udp_recv(
        udp_pcb_bridge,
        UDP_Receive_Callback,
        NULL
    );
}

/* =========================================================
   MAIN
   ========================================================= */

int main(void)
{
    MPU_Config();

    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    USART1_Init();

    MX_LWIP_Init();

    UDP_Bridge_Init();

    while (1)
    {
        MX_LWIP_Process();
    }
}

