  * @file           : main.c
  * @brief          : Simple UART Echo Test (PC <-> STM32F767 via ST-LINK VCP)
  ******************************************************************************
  */
/* USER CODE END Header */

#include "main.h"
#include <string.h>

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart3;
uint8_t rx_data;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

/* Main Application ----------------------------------------------------------*/
int main(void)
{
    /* 1. Khởi tạo thư viện HAL, cấu hình Flash và Tick timer */
    HAL_Init();

    /* 2. Cấu hình xung nhịp hệ thống */
    SystemClock_Config();

    /* 3. Khởi tạo chân GPIO cho UART */
    MX_GPIO_Init();

    /* 4. Khởi tạo ngoại vi USART3 (115200 baud) */
    MX_USART3_UART_Init();

    /* 5. Gửi thông báo chào mừng qua cổng USB VCP lên máy tính */
    char *msg = "\r\n[STM32F767] UART Echo Connected Successfully!\r\n";
    HAL_UART_Transmit(&huart3, (uint8_t*)msg, strlen(msg), 100);

    /* 6. Kích hoạt ngắt nhận từng ký tự từ máy tính */
    if (HAL_UART_Receive_IT(&huart3, &rx_data, 1) != HAL_OK)
    {
        Error_Handler();
    }

    /* Vòng lặp vô hạn chờ ngắt UART */
    while (1)
    {
    }
}

/* UART Receive Complete Callback (Xử lý ngắt nhận) --------------------------*/
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART3)
    {
        /* Gửi trả lại (Echo) chính ký tự vừa nhận được về máy tính */
        HAL_UART_Transmit(&huart3, &rx_data, 1, 100);

        /* Tiếp tục lắng nghe ký tự tiếp theo từ máy tính */
        if (HAL_UART_Receive_IT(&huart3, &rx_data, 1) != HAL_OK)
        {
            Error_Handler();
        }
    }
}

