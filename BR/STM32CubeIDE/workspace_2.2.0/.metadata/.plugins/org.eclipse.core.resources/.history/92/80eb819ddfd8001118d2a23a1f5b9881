#include "main.h"
#include "lwip.h"
#include "lwip/udp.h"
#include <string.h>

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1; // Kết nối Hoverboard (PA9/PA10 - 9600 baud)
struct udp_pcb *udp_server_pcb;

/* Cấu hình IP cho STM32 (Có thể thay đổi tùy thuộc vào mạng LAN của bạn) */
#define STM32_IP_ADDR0   192
#define STM32_IP_ADDR1   168
#define STM32_IP_ADDR2   1
#define STM32_IP_ADDR3   100

#define UDP_SERVER_PORT  5000 // Port nhận dữ liệu UDP từ Ubuntu

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
void Error_Handler(void);
void udp_server_init(void);
void udp_server_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port);

/* Main Application ----------------------------------------------------------*/
int main(void)
{
    /* 1. Khởi tạo thư viện HAL */
    HAL_Init();

    /* 2. Cấu hình xung nhịp hệ thống */
    SystemClock_Config();

    /* 3. Khởi tạo chân GPIO */
    MX_GPIO_Init();

    /* 4. Khởi tạo ngoại vi USART1 giao tiếp Hoverboard (9600 baud) */
    MX_USART1_UART_Init();

    /* 5. Khởi tạo ngăn xếp mạng LwIP và Ethernet */
    MX_LWIP_Init();

    /* 6. Khởi tạo UDP Server lắng nghe gói tin từ Ubuntu */
    udp_server_init();

    /* Vòng lặp chính xử lý tiến trình mạng */
    while (1)
    {
        /* Xử lý gói tin mạng đến (Bắt buộc đối với LwIP không dùng hệ điều hành RTOS) */
        MX_LWIP_Process();
    }
}

/* Khởi tạo UDP Server lắng nghe trên cổng 5000 ------------------------------*/
void udp_server_init(void)
{
    err_t err;
    ip4_addr_t my_ip;

    IP4_ADDR(&my_ip, STM32_IP_ADDR0, STM32_IP_ADDR1, STM32_IP_ADDR2, STM32_IP_ADDR3);

    /* Tạo một UDP Protocol Control Block mới */
    udp_server_pcb = udp_new();
    if (udp_server_pcb != NULL)
    {
        /* Gắn kết PCB với địa chỉ IP cục bộ và cổng */
        err = udp_bind(udp_server_pcb, &my_ip, UDP_SERVER_PORT);
        if (err == ERR_OK)
        {
            /* Đăng ký hàm callback xử lý khi có gói tin UDP gửi đến */
            udp_recv(udp_server_pcb, udp_server_callback, NULL);
        }
        else
        {
            Error_Handler();
        }
    }
}

/* Hàm Callback nhận dữ liệu UDP từ Ubuntu ----------------------------------*/
void udp_server_callback(void *arg, struct udp_pcb *upcb, struct pbuf *p, const ip_addr_t *addr, u16_t port)
{
    if (p != NULL)
    {
        /* Kiểm tra kích thước gói dữ liệu (Ví dụ gói điều khiển hoverboard chuẩn 8 bytes) */
        if (p->len >= 8)
        {
            uint8_t hover_packet[8];

            /* Sao chép dữ liệu từ bộ đệm mạng pbuf sang mảng byte */
            pbuf_copy_partial(p, hover_packet, 8, 0);

            /* Chuyển tiếp trực tiếp xuống Hoverboard qua USART1 (PA9/PA10) */
            HAL_UART_Transmit(&huart1, hover_packet, 8, 100);
        }

        /* Giải phóng bộ đệm mạng pbuf sau khi xử lý xong */
        pbuf_free(p);
    }
}

