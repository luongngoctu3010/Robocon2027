/*=========================================
 * ERROR HANDLER
 *=========================================*/

void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
    }
}

/*=========================================
 * MAIN
 *=========================================*/

int main(void)
{
    /* Initialize HAL */

    HAL_Init();

    /* System clock 216 MHz */

    SystemClock_Config();

    /* GPIO */

    MX_GPIO_Init();

    /* USART1 */

    MX_USART1_UART_Init();

    /* Ethernet and LwIP */

    MX_LWIP_Init();

    /* UDP server port 5000 */

    UDP_Server_Init();

    /* Initial STOP */

    Hoverboard_Send_Stop();

    /*=====================================
     * MAIN LOOP
     *=====================================*/

    while (1)
    {
        /*
         * Process Ethernet and LwIP.
         */

        MX_LWIP_Process();

        /*
         * Process Hoverboard UART.
         */

        Hoverboard_Process();
    }
}
