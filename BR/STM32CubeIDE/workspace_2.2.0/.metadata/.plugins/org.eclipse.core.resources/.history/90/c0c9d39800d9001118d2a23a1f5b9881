#include "main.h"

#include "lwip.h"
#include "lwip/udp.h"
#include "lwip/pbuf.h"
#include "lwip/err.h"

#include <stdint.h>
#include <string.h>

/*=========================================
 * CONFIGURATION
 *=========================================*/

#define UART_BAUDRATE              115200

#define UDP_PORT                   5000

#define HOVERBOARD_START           0xABCD

#define HOVERBOARD_PACKET_SIZE     8

#define UDP_TIMEOUT_MS             200

#define UART_PERIOD_MS             20

#define UART_TIMEOUT_MS            10

/*=========================================
 * UART HANDLE
 *=========================================*/

UART_HandleTypeDef huart1;

/*=========================================
 * UDP VARIABLES
 *=========================================*/

static struct udp_pcb *udp_pcb_control = NULL;

static uint8_t hoverboard_packet[HOVERBOARD_PACKET_SIZE];

static uint8_t packet_received = 0;

static uint32_t last_udp_tick = 0;

static uint32_t last_uart_tick = 0;

/*=========================================
 * FUNCTION PROTOTYPES
 *=========================================*/

void SystemClock_Config(void);

void MX_GPIO_Init(void);

void MX_USART1_UART_Init(void);

void UDP_Server_Init(void);

void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
);

uint16_t Read_U16_LE(const uint8_t *data);

uint8_t Validate_Hoverboard_Packet(
    const uint8_t *data
);

void Hoverboard_Send_Stop(void);

void Hoverboard_Process(void);

void Error_Handler(void);

/*=========================================
 * READ UINT16 LITTLE ENDIAN
 *=========================================*/

uint16_t Read_U16_LE(const uint8_t *data)
{
    return
        (uint16_t)data[0] |
        ((uint16_t)data[1] << 8);
}

/*=========================================
 * VALIDATE HOVERBOARD PACKET
 *
 * Packet:
 *
 * BYTE 0-1: START 0xABCD
 * BYTE 2-3: STEER
 * BYTE 4-5: SPEED
 * BYTE 6-7: CHECKSUM
 *
 * CHECKSUM = START ^ STEER ^ SPEED
 *=========================================*/

uint8_t Validate_Hoverboard_Packet(
    const uint8_t *data
)
{
    uint16_t start;
    uint16_t steer;
    uint16_t speed;
    uint16_t checksum;

    start = Read_U16_LE(&data[0]);

    steer = Read_U16_LE(&data[2]);

    speed = Read_U16_LE(&data[4]);

    checksum = Read_U16_LE(&data[6]);

    if (start != HOVERBOARD_START)
    {
        return 0;
    }

    if ((uint16_t)(start ^ steer ^ speed) != checksum)
    {
        return 0;
    }

    return 1;
}

/*=========================================
 * UDP RECEIVE CALLBACK
 *=========================================*/

void UDP_Receive_Callback(
    void *arg,
    struct udp_pcb *pcb,
    struct pbuf *p,
    const ip_addr_t *addr,
    u16_t port
)
{
    uint8_t temp[HOVERBOARD_PACKET_SIZE];

    (void)arg;
    (void)pcb;
    (void)addr;
    (void)port;

    if (p == NULL)
    {
        return;
    }

    /*
     * Only accept 8-byte packets.
     */

    if (p->tot_len == HOVERBOARD_PACKET_SIZE)
    {
        if (pbuf_copy_partial(
                p,
                temp,
                HOVERBOARD_PACKET_SIZE,
                0
            ) == HOVERBOARD_PACKET_SIZE)
        {
            /*
             * Check START_FRAME and checksum.
             */

            if (Validate_Hoverboard_Packet(temp))
            {
                memcpy(
                    hoverboard_packet,
                    temp,
                    HOVERBOARD_PACKET_SIZE
                );

                last_udp_tick = HAL_GetTick();

                packet_received = 1;
            }
        }
    }

    pbuf_free(p);
}

/*=========================================
 * UDP SERVER INIT
 *=========================================*/

void UDP_Server_Init(void)
{
    udp_pcb_control = udp_new();

    if (udp_pcb_control == NULL)
    {
        Error_Handler();
    }

    if (udp_bind(
            udp_pcb_control,
            IP_ADDR_ANY,
            UDP_PORT
        ) != ERR_OK)
    {
        udp_remove(udp_pcb_control);

        udp_pcb_control = NULL;

        Error_Handler();
    }

    udp_recv(
        udp_pcb_control,
        UDP_Receive_Callback,
        NULL
    );

    memset(
        hoverboard_packet,
        0,
        sizeof(hoverboard_packet)
    );

    packet_received = 0;

    last_udp_tick = HAL_GetTick();

    last_uart_tick = HAL_GetTick();
}

/*=========================================
 * USART1 INIT
 *
 * PA9  = USART1_TX
 * PA10 = USART1_RX
 *
 * Baudrate = 115200
 * Format   = 8N1
 *=========================================*/

void MX_USART1_UART_Init(void)
{
    huart1.Instance = USART1;

    huart1.Init.BaudRate = UART_BAUDRATE;

    huart1.Init.WordLength = UART_WORDLENGTH_8B;

    huart1.Init.StopBits = UART_STOPBITS_1;

    huart1.Init.Parity = UART_PARITY_NONE;

    huart1.Init.Mode = UART_MODE_TX_RX;

    huart1.Init.HwFlowCtl = UART_HWCONTROL_NONE;

    huart1.Init.OverSampling = UART_OVERSAMPLING_16;

    huart1.Init.OneBitSampling =
        UART_ONE_BIT_SAMPLE_DISABLE;

    huart1.AdvancedInit.AdvFeatureInit =
        UART_ADVFEATURE_NO_INIT;

    if (HAL_UART_Init(&huart1) != HAL_OK)
    {
        Error_Handler();
    }
}

/*=========================================
 * GPIO INIT
 *=========================================*/

void MX_GPIO_Init(void)
{
    __HAL_RCC_GPIOA_CLK_ENABLE();

    __HAL_RCC_GPIOB_CLK_ENABLE();

    __HAL_RCC_GPIOC_CLK_ENABLE();
}

/*=========================================
 * SEND STOP COMMAND
 *
 * START    = 0xABCD
 * STEER    = 0
 * SPEED    = 0
 * CHECKSUM = 0xABCD
 *=========================================*/

void Hoverboard_Send_Stop(void)
{
    uint8_t stop_packet[HOVERBOARD_PACKET_SIZE] =
    {
        0xCD, 0xAB,
        0x00, 0x00,
        0x00, 0x00,
        0xCD, 0xAB
    };

    HAL_UART_Transmit(
        &huart1,
        stop_packet,
        HOVERBOARD_PACKET_SIZE,
        UART_TIMEOUT_MS
    );
}

/*=========================================
 * HOVERBOARD PROCESS
 *
 * Send command every 20 ms.
 *
 * If UDP timeout > 200 ms:
 * Send STOP.
 *=========================================*/

void Hoverboard_Process(void)
{
    uint32_t now = HAL_GetTick();

    /*
     * UART transmission period = 20 ms
     * 50 Hz
     */

    if ((now - last_uart_tick) < UART_PERIOD_MS)
    {
        return;
    }

    last_uart_tick = now;

    /*
     * WATCHDOG
     *
     * No valid UDP packet for 200 ms.
     */

    if ((!packet_received) ||
        ((now - last_udp_tick) > UDP_TIMEOUT_MS))
    {
        Hoverboard_Send_Stop();

        return;
    }

    /*
     * Forward valid UDP packet to Hoverboard.
     *
     * USART1 TX -> Hoverboard RX
     */

    HAL_UART_Transmit(
        &huart1,
        hoverboard_packet,
        HOVERBOARD_PACKET_SIZE,
        UART_TIMEOUT_MS
    );
}

