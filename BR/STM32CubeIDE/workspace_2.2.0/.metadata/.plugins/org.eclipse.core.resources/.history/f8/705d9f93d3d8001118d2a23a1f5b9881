#include "main.h"

UART_HandleTypeDef huart3;
uint8_t rx_data;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART3_UART_Init();

    /* Bắt đầu bật ngắt nhận từng byte từ Ubuntu */
    HAL_UART_Receive_IT(&huart3, &rx_data, 1);

    while (1)
    {
        // Chờ ngắt UART
    }
}

/* Hàm ngắt tự động gọi khi nhận được dữ liệu từ Ubuntu */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART3)
    {
        /* Gửi trả lại (Echo) chính ký tự vừa nhận được về Ubuntu */
        HAL_UART_Transmit(&huart3, &rx_data, 1, 100);

        /* Tiếp tục lắng nghe ký tự tiếp theo */
        HAL_UART_Receive_IT(&huart3, &rx_data, 1);
    }
}

