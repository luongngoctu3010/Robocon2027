
#include "main.h"
#include <stdint.h>
#include <string.h>

/* UART Handle */
UART_HandleTypeDef huart3;

/* Function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);


/* ================= MAIN ================= */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    MX_USART3_UART_Init();

    uint8_t rx_data;

    const char *welcome = "\r\nSTM32F767 READY - ECHO TEST\r\n";

    HAL_UART_Transmit(
        &huart3,
        (uint8_t *)welcome,
        strlen(welcome),
        1000
    );

    while (1)
    {
        if (HAL_UART_Receive(
                &huart3,
                &rx_data,
                1,
                HAL_MAX_DELAY
            ) == HAL_OK)
        {
            HAL_UART_Transmit(
                &huart3,
                &rx_data,
                1,
                1000
            );
        }
    }
}


