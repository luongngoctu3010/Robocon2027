<?xml version="1.0"?>
<sdf version="1.10">
<world name="robocon2027">

<physics name="default_physics" type="ode">
<max_step_size>0.001</max_step_size>
<real_time_factor>1</real_time_factor>
<real_time_update_rate>1000</real_time_update_rate>
</physics>

<scene>
<ambient>0.4 0.4 0.4 1</ambient>
<background>0.7 0.7 0.7 1</background>
<shadows>true</shadows>
</scene>

<light name="sun" type="directional">
<cast_shadows>true</cast_shadows>
<pose>0 0 10 0 0 0</pose>
<diffuse>1 1 1 1</diffuse>
<specular>0.2 0.2 0.2 1</specular>
<direction>-0.3 -0.3 -1</direction>
</light>

<model name="field">
<static>true</static>

<link name="field_link">

<visual name="field_visual">
<pose>0 0 0 1.5708 0 0</pose>
<geometry>
<mesh>
<uri>model://robocon2027_description/meshes/visual/robocon2027.glb</uri>
</mesh>
</geometry>
</visual>

<collision name="field_collision">
<geometry>
<mesh>
<uri>model://robocon2027_description/meshes/field/field.stl</uri>
</mesh>
</geometry>
</collision>

</link>
</model>

<model name="cylinder">
<static>true</static>

<link name="cylinder_link">

<collision name="cylinder_collision">
<geometry>
<mesh>
<uri>model://robocon2027_description/meshes/field/cylinder.stl</uri>
</mesh>
</geometry>
</collision>

</link>
</model>

<model name="tower">
<static>true</static>

<link name="tower_link">

<collision name="tower_collision">
<geometry>
<mesh>
<uri>model://robocon2027_description/meshes/field/tower.stl</uri>
</mesh>
</geometry>
</collision>

</link>
</model>

</world>
</sdf>
